# =============================================================================
# Fraud Detection System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The API gateway and The Yapper agent read these at startup.
# =============================================================================

# ── OpenRouter LLM (required for The Yapper LLM explanations) ──────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for explanations (default: openai/gpt-4o-mini)
# Other options: google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku, etc.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: base URL override (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: site URL and app name sent in OpenRouter headers
# OPENROUTER_SITE_URL=http://localhost
# OPENROUTER_APP_NAME=Fraud Detection System

# ── API Gateway ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────────────────────────────────
# API key for header-based authentication (X-API-Key header).
# Leave empty to disable auth (development only).
API_KEY=

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:8501 (Streamlit frontend)
CORS_ALLOW_ORIGINS=http://localhost:8501

# Max request body size in bytes (default: 1 MB)
MAX_BODY_BYTES=1048576

# Rate limits (per IP). Format: "N/period" — e.g. 60/minute, 10/second
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_EXPLAIN=30/minute
RATE_LIMIT_DEFAULT=120/minute

# ── Orchestrator ───────────────────────────────────────────────────────────
USE_LANGGRAPH=true
STRICT_LANGGRAPH=true
ORCHESTRATOR_PARALLEL=true
ORCHESTRATOR_TIMEOUT_MS=5000
MODEL_PRIMARY_WEIGHT=0.75
