# =============================================================================
# Fraud Detection System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The API gateway and The Yapper agent read these at startup.
# =============================================================================

# ── Google Gemini LLM (required for The Yapper LLM explanations) ───────────
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Model for explanations (cascade: primary → fallback models)
GOOGLE_MODEL=gemini-2.5-flash-lite

# ── API Gateway ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────────────────────────────────
# API key for header-based authentication (X-API-Key header).
# Leave empty to disable auth (development only).
API_KEY=

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:8501 (Streamlit frontend)
CORS_ALLOW_ORIGINS=http://localhost:8501

# Max request body size in bytes (default: 1 MB)
MAX_BODY_BYTES=1048576

# Rate limits (per IP). Format: "N/period" — e.g. 60/minute, 10/second
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_EXPLAIN=30/minute
RATE_LIMIT_DEFAULT=120/minute

# ── Orchestrator ───────────────────────────────────────────────────────────
USE_LANGGRAPH=true
STRICT_LANGGRAPH=true
ORCHESTRATOR_PARALLEL=true
ORCHESTRATOR_TIMEOUT_MS=5000
MODEL_PRIMARY_WEIGHT=0.75
